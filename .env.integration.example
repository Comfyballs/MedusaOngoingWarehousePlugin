# Live Ongoing integration-test credentials. Copy to .env.integration (git-ignored)
# and fill in your SANDBOX goods-owner values. Then: `yarn test:live`.

# Master switch. Read-path live tests run only when this is exactly "1".
ONGOING_LIVE=1

# Ongoing REST base URL — MUST include the /api/v1 suffix, no trailing slash.
# e.g. https://api.ongoingsystems.se/<instance>/api/v1
ONGOING_URL=

# Basic-auth credentials for the Ongoing REST API.
ONGOING_USER=
ONGOING_PASS=

# Goods-owner id (integer) of the SANDBOX warehouse.
ONGOING_GOODS_OWNER=

# Optional: run the heavy full-order-history pagination sweep (minutes on a real
# warehouse; walks every order at concurrency 1). Off by default.
ONGOING_LIVE_HEAVY=0

# Second switch, gates the write round-trip (putArticle -> putOrder -> cancelOrder).
# Leave unset/0 for read-only runs. Set to "1" ONLY against a throwaway sandbox —
# it creates a real order in the warehouse and then cancels it.
ONGOING_LIVE_WRITES=0
