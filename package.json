{
  "name": "MedusaOngoingWarehousePlugin",
  "version": "0.0.1",
  "description": "Medusa v2 plugin integrating the Ongoing Warehouse WMS: order fulfillment, shipment status, and inventory sync.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa-v2"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.integration.js --runInBand --forceExit",
    "test:live": "jest --config jest.integration.config.js",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.16.0",
    "@medusajs/cli": "2.16.0",
    "@medusajs/eslint-plugin": "2.16.0",
    "@medusajs/framework": "2.16.0",
    "@medusajs/icons": "2.16.0",
    "@medusajs/js-sdk": "2.16.0",
    "@medusajs/medusa": "2.16.0",
    "@medusajs/test-utils": "2.16.0",
    "@medusajs/ui": "4.1.16",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2",
    "@types/jest": "^29",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29",
    "jiti": "^2.0.0",
    "nock": "^13.5.6",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.16.0",
    "@medusajs/cli": "2.16.0",
    "@medusajs/framework": "2.16.0",
    "@medusajs/icons": "2.16.0",
    "@medusajs/medusa": "2.16.0",
    "@medusajs/test-utils": "2.16.0",
    "@medusajs/ui": "4.1.16"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.6.0",
  "resolutions": {
    "buffer-equal-constant-time@npm:1.0.1": "patch:buffer-equal-constant-time@npm%3A1.0.1#~/.yarn/patches/buffer-equal-constant-time-npm-1.0.1-41826f3419.patch"
  }
}
